gleamclient.xyz {
    root * /var/www/orion-client
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        -Server
    }
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=3600"
    header /downloads/* Cache-Control "no-cache"
    handle /v1/* {
        request_body {
            max_size 64KB
        }
        reverse_proxy 127.0.0.1:8765 {
            header_up X-Real-IP {remote_host}
            transport http {
                read_timeout 30s
            }
        }
    }
    handle /auth.html {
        reverse_proxy 127.0.0.1:8088
    }
    handle /api/* {
        request_body {
            max_size 4KB
        }
        reverse_proxy 127.0.0.1:8088 {
            header_up X-Real-IP {remote_host}
        }
    }
    handle {
        file_server
    }
}

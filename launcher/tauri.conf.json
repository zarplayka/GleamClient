{
  "productName": "Gleam Launcher",
  "version": "0.1.47",
  "identifier": "xyz.gleamclient.launcher",
  "build": {
    "frontendDist": [
      "../website/tools/launcher-preview.html",
      "../website/tools/launcher-background-1-16-5.webp",
      "../website/tools/launcher-background-1-21-4.webp",
      "../website/tools/launcher-background-1-21-11.webp",
      "../website/tools/launcher-background-26-1-2.webp",
      "../website/tools/launcher-background-26-2.webp",
      "../website/tools/launcher-background-26-3.webp",
      "../website/tools/launcher-cosmetics.js",
      "../website/tools/launcher-default-skin.png",
      "../build/launcher-cosmetics.json",
      "../src/main/resources/assets/orion-client/cosmetics/pets/ember_fox.json",
      "../src/main/resources/assets/orion-client/cosmetics/pets/moon_moth.json",
      "../src/main/resources/assets/orion-client/cosmetics/pets/moss_turtle.json",
      "../src/main/resources/assets/orion-client/cosmetics/pets/rhm_tarnkappe.mesh",
      "../src/main/resources/assets/orion-client/cosmetics/pets/snow_ferret.json",
      "../src/main/resources/assets/orion-client/cosmetics/pets/space_slime.json",
      "../src/main/resources/assets/orion-client/cosmetics/pets/tracked_scout.json",
      "../src/main/resources/assets/orion-client/textures/cosmetics/pets/ember_fox.png",
      "../src/main/resources/assets/orion-client/textures/cosmetics/pets/moon_moth.png",
      "../src/main/resources/assets/orion-client/textures/cosmetics/pets/moss_turtle.png",
      "../src/main/resources/assets/orion-client/textures/cosmetics/pets/rhm_tarnkappe.png",
      "../src/main/resources/assets/orion-client/textures/cosmetics/pets/snow_ferret.png",
      "../src/main/resources/assets/orion-client/textures/cosmetics/pets/space_slime.png",
      "../src/main/resources/assets/orion-client/textures/cosmetics/pets/tracked_scout.png"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gleam Launcher",
        "url": "launcher-preview.html",
        "width": 1360,
        "height": 800,
        "minWidth": 690,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#18161b"
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "launcher-window",
          "windows": ["main"],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:window:allow-close",
            "core:window:allow-minimize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-is-maximized",
            "core:window:allow-start-dragging",
            "core:window:allow-internal-toggle-maximize"
          ]
        }
      ]
    }
  },
  "bundle": {
    "icon": ["icons/icon.ico"]
  }
}
